{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run env:check)",
      "Bash(npm run docs:check)",
      "Bash(npm run architecture:check)",
      "Bash(npm run unused:check)",
      "Bash(npm run api:check)",
      "Bash(npm run api:generate)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run verify)",
      "Bash(npm run verify:full)",
      "Bash(npm run test:runtime)",
      "Bash(npm run test:board)",
      "Bash(npm run test:tooling)",
      "Bash(npm test:*)",
      "Bash(npx jest:*)",
      "Bash(npx biome check:*)",
      "Bash(npm ci)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(uv sync --locked)",
      "Bash(uv run pytest:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-file.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-git-hooks.sh"
          }
        ]
      }
    ]
  }
}

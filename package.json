{
  "name": "knightly-rebuild",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "index.ts",
  "engines": {
    "node": "24.21.0",
    "npm": "11.21.0"
  },
  "packageManager": "npm@11.21.0",
  "scripts": {
    "eas-build-pre-install": "npm install --global npm@11.21.0 && npm run env:check",
    "env:check": "node scripts/check-environment.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "docs:check": "node scripts/check-docs.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "test:tooling": "node --test scripts/check-environment.test.mjs scripts/check-docs.test.mjs scripts/check-architecture.test.mjs scripts/verify.test.mjs scripts/runtime-process.test.mjs scripts/verify-runtime.test.mjs scripts/verify-native.test.mjs scripts/runtime-evidence.test.mjs",
    "test:ci": "jest --ci --runInBand",
    "expo:check": "expo install --check",
    "expo:doctor": "expo-doctor",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:native": "cross-env STORYBOOK_ENABLED=true expo start --dev-client",
    "export": "expo export --platform all",
    "storybook:web": "storybook dev -p 6006 --no-open --disable-telemetry",
    "test:runtime": "node scripts/verify-runtime.mjs",
    "test:native": "node scripts/verify-native.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "sounds:generate": "node scripts/generate-board-sounds.mjs",
    "brand:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-brand.mjs",
    "build:ios:testflight": "cross-env LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx eas-cli@24.12.1 build --platform ios --profile testflight --local --output build/knightly-testflight.ipa",
    "submit:ios:testflight": "cross-env LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx eas-cli@24.12.1 submit --platform ios --profile testflight --path build/knightly-testflight.ipa",
    "release:ios:testflight": "npm run build:ios:testflight && npm run submit:ios:testflight",
    "build:ios:beta": "cross-env LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx eas-cli@24.12.1 build --platform ios --profile beta --local --output build/knightly-beta.ipa",
    "submit:ios:beta": "cross-env LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx eas-cli@24.12.1 submit --platform ios --profile beta --path build/knightly-beta.ipa",
    "release:ios:beta": "npm run build:ios:beta && npm run submit:ios:beta",
    "build:ios:cloud": "cross-env LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx eas-cli@24.12.1 build --platform ios --profile testflight",
    "api:check": "node scripts/generate-api.mjs --check",
    "dev:foundation": "expo start --dev-client --localhost --port 8095",
    "web:foundation": "expo start --web --localhost --port 8095",
    "api:local": "cd backend && uv run python scripts/run-local-dev.py",
    "worker:local": "cd backend && PYTHONUNBUFFERED=1 uv run python scripts/run-local-dev.py --worker",
    "web:local": "cross-env EXPO_PUBLIC_API_URL=http://127.0.0.1:8005 EXPO_PUBLIC_DEV_AUTH=local expo start --web --localhost --port 8095",
    "ios:foundation": "expo run:ios --port 8095",
    "test:board": "node scripts/verify-runtime.mjs --board-only",
    "unused:check": "sb-rn-get-stories && knip",
    "source:publish": "node scripts/publish-source.mjs",
    "postinstall": "patch-package --error-on-fail && node scripts/prepare-chart-web.mjs && node scripts/prepare-engine-web.mjs"
  },
  "dependencies": {
    "@clerk/expo": "4.10.1",
    "@clerk/shared": "4.40.0",
    "@expo/ui": "57.0.26",
    "@marceloterreiro/flash-calendar": "2.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "chess.js": "1.4.0",
    "expo": "57.0.31",
    "expo-asset": "57.0.20",
    "expo-audio": "57.0.5",
    "expo-auth-session": "57.0.16",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.13",
    "expo-notifications": "57.0.24",
    "expo-router": "57.0.29",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.24",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "knightly-stockfish": "file:modules/stockfish",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1",
    "stockfish": "19.0.1",
    "victory-native": "42.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@gorhom/bottom-sheet": "5.2.14",
    "@playwright/test": "1.64.0",
    "@storybook/react-native": "10.4.3",
    "@storybook/react-native-ui": "10.4.3",
    "@storybook/react-native-web-vite": "10.6.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "cross-env": "10.1.0",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "knip": "6.41.0",
    "openapi-typescript": "7.13.0",
    "patch-package": "8.0.1",
    "react-test-renderer": "19.2.3",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

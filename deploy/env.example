# /opt/knightly/<env>/.env on the server (chmod 600). One per environment: staging, production.
# docs/deploy.md says where each value comes from.

KNIGHTLY_ENV=production
KNIGHTLY_MODE=server

# The database runs beside the API as Compose's `db` service; pick a long random password
# (openssl rand -hex 24). It never leaves this machine's Compose network.
KNIGHTLY_DB_PASSWORD=
KNIGHTLY_DATABASE_URL=postgresql://postgres:<KNIGHTLY_DB_PASSWORD>@db:5432/knightly
# Before the move (docs/deploy.md, "Moving the database onto the VM"), this was the Supabase
# session pooler (port 5432), kept afterwards as KNIGHTLY_SUPABASE_URL for rollback.

# Clerk › API keys of this environment's instance (production: pk_live_...).
CLERK_PUBLISHABLE_KEY=
# Clerk › Webhooks › an endpoint https://<your domain>/api/webhooks/clerk for user.deleted.
CLERK_WEBHOOK_SECRET=
# Only accept sign-in tokens made for this site.
KNIGHTLY_ALLOWED_ORIGINS=https://<your domain>
# Set to 1 when this server also serves the native app. Signature, issuer and expiry
# checks still apply; browser origins must still match KNIGHTLY_ALLOWED_ORIGINS.
KNIGHTLY_ALLOW_NATIVE_AUTH=0

# Cloudflare › Zero Trust › Networks › Tunnels › this environment's tunnel › its token.
TUNNEL_TOKEN=

# Clerk user ids (comma-separated) that see the admin page: the job queue and everyone's usage.
KNIGHTLY_ADMINS=
# Per-user limits (src/knightly/limits.py): how far back a first import reaches, and how many
# games are analysed in all (new games always are). Defaults 24 and 1000; 0 = no limit.
#KNIGHTLY_HISTORY_MONTHS=24
#KNIGHTLY_MAX_ANALYSED=1000

# Chess.com asks API clients for a contact in the User-Agent.
KNIGHTLY_CONTACT=<your email>

# Optional monitoring.
SENTRY_DSN=
KNIGHTLY_HEARTBEAT_URL=

# The worker's CPU share on this machine (production 2, staging 0.5).
WORKER_CPUS=2

# Deployment writes KNIGHTLY_IMAGE_REPOSITORY and KNIGHTLY_IMAGE_TAG together.
# Production also records KNIGHTLY_LEGACY_WEB_IMAGE and COMPOSE_PROFILES=legacy
# to keep the pinned original frontend running for rollback; nginx no longer routes to it.
